{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/share/**/*.html": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/share/*.html": true,
    "**/dist/*.html": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/share/*.html": true,
    "**/dist/*.html": true
  },
  "files.readonlyInclude": {
    "**/share/*.html": true,
    "**/dist/*.html": true
  },
  "workbench.editorLargeFileConfirmation": 0.3,
  "editor.largeFileOptimizations": true
}
